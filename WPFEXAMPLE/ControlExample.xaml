<Window x:Class="WPFEXAMPLE.ControlExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFEXAMPLE"
        mc:Ignorable="d"
        Title="ControlExample" Height="450" Width="800">
    <StackPanel>
        <TextBox x:Name="txtbox"/>
        <Button Content="버튼1" Click="Button_Click"/>
        <ListBox x:Name="listbox" Height="50"/>
        <Button Content="버튼2" Click="Button_Click_1"/>
        <ComboBox x:Name="combo" Height="50"/>

    </StackPanel>
</Window>
